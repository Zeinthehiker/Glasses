# Optional, for local development in a desktop browser only (`npm run dev`).
# Anything prefixed with VITE_ could end up in built JavaScript, so these are
# only read in dev mode and must never be needed for `npm run pack`.
# On the phone, paste keys into the app's Settings screen instead; they are
# stored on the phone, not in the build or the repo.
VITE_ELEVENLABS_API_KEY=
VITE_WISPR_API_KEY=
